<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/margin_screen"
        android:paddingRight="@dimen/margin_screen"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/headerIcon"
                android:layout_width="@dimen/header_icon_size"
                android:layout_height="@dimen/header_icon_size"
                android:background="@drawable/icon_bg"
                android:src="@drawable/ic_shield"
                android:padding="9dp"
                android:contentDescription="FamilyOnly" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingLeft="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_title"
                    style="@style/Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_subtitle"
                    style="@style/Small"
                    android:paddingTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:elevation="@dimen/card_elevation"
            android:padding="@dimen/card_padding"
            android:layout_marginTop="@dimen/gap_section">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/avatar_circle"
                    android:src="@drawable/ic_phone"
                    android:padding="9dp"
                    android:contentDescription="Screening" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_heading"
                        style="@style/CardTitle" />

                    <TextView
                        android:id="@+id/statusCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 trusted"
                        style="@style/Small"
                        android:paddingTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_inactive"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/inactive_text"
                    android:background="@drawable/pill_inactive"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_desc"
                style="@style/Body"
                android:paddingTop="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trusted_title"
            style="@style/SectionLabel"
            android:paddingTop="22dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:elevation="@dimen/card_elevation"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/trusted_title"
                    style="@style/CardTitle" />

                <TextView
                    android:id="@+id/trustedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    style="@style/Small" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <EditText
                    android:id="@+id/trustedInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/trusted_hint"
                    android:inputType="phone"
                    style="@style/InputField" />

                <ImageButton
                    android:id="@+id/btnAdd"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/btn_primary"
                    android:src="@drawable/ic_plus"
                    android:padding="14dp"
                    android:contentDescription="@string/trusted_add" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/warning_background"
                android:padding="14dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:src="@drawable/ic_warning"
                    android:contentDescription="Warning" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trusted_empty_title"
                        android:textSize="14sp"
                        android:textColor="@color/warning_text"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trusted_empty_desc"
                        android:textSize="12sp"
                        android:textColor="@color/warning_text"
                        android:paddingTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/trustedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/handling_title"
            style="@style/SectionLabel"
            android:paddingTop="22dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:elevation="@dimen/card_elevation"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/handling_title"
                style="@style/CardTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/handling_desc"
                style="@style/Body"
                android:paddingTop="4dp" />

            <Button
                android:id="@+id/btnEnable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_enable"
                style="@style/PrimaryButton"
                android:layout_marginTop="14dp"
                android:drawableLeft="@drawable/ic_shield"
                android:drawablePadding="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fwd_label"
                style="@style/Small"
                android:paddingTop="16dp" />

            <EditText
                android:id="@+id/fwdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/fwd_hint"
                android:text="9999999999"
                android:inputType="phone"
                style="@style/InputField"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fwd_desc"
                style="@style/Small"
                android:paddingTop="8dp" />

            <Button
                android:id="@+id/btnForward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_forward"
                style="@style/PrimaryButton"
                android:layout_marginTop="12dp"
                android:drawableLeft="@drawable/ic_forward_white"
                android:drawablePadding="10dp" />

            <Button
                android:id="@+id/btnCancelFwd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_cancel_fwd"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log_title"
            style="@style/SectionLabel"
            android:paddingTop="22dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:elevation="@dimen/card_elevation"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_title"
                style="@style/CardTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_desc"
                style="@style/Body"
                android:paddingTop="4dp" />

            <Button
                android:id="@+id/btnErase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_erase"
                style="@style/DestructiveButton"
                android:layout_marginTop="14dp"
                android:drawableLeft="@drawable/ic_trash"
                android:drawablePadding="10dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Blocked callers hear your busy-forward announcement. Family numbers always ring."
            style="@style/Small"
            android:gravity="center"
            android:paddingTop="18dp" />
    </LinearLayout>
</ScrollView>
